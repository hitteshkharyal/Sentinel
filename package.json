{
  "name": "sentinel",
  "version": "0.1.0",
  "private": true,
  "description": "Privacy-Preserving Autonomous Sensor Intelligence & Automation Platform",
  "scripts": {
    "dev:web": "npm run dev --workspace=apps/web",
    "dev:api": "npm run dev --workspace=apps/api",
    "dev": "npm run dev:api & npm run dev:web",
    "build:web": "npm run build --workspace=apps/web",
    "build:api": "npm run build --workspace=apps/api",
    "build:shared": "npm run build --workspace=packages/shared",
    "build:validation": "npm run build --workspace=packages/validation",
    "build:types": "npm run build --workspace=packages/types",
    "build": "npm run build:types && npm run build:shared && npm run build:validation && npm run build:api && npm run build:web",
    "lint": "eslint . --ext .ts,.tsx --max-warnings 0",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "format": "prettier --write \"**/*.{ts,tsx,json,md,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,json,md,css}\"",
    "test": "echo \"Tests will be configured per-workspace\"",
    "clean": "rimraf apps/web/dist apps/api/dist packages/shared/dist packages/validation/dist packages/types/dist"
  },
  "workspaces": [
    "packages/types",
    "packages/shared",
    "packages/validation",
    "apps/api",
    "apps/web"
  ],
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.34.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "prettier": "^3.2.0",
    "rimraf": "^5.0.5",
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
