# ─────────────────────────────────────────────
# SENTINEL — Environment Configuration
# ─────────────────────────────────────────────
# Copy this file to .env and fill in real values.
# NEVER commit .env — only .env.example.

# ── Node ──
NODE_ENV=development
PORT=4000

# ── MongoDB ──
MONGODB_URI=mongodb://localhost:27017/sentinel

# ── JWT ──
JWT_SECRET=CHANGE_ME_IN_PRODUCTION
JWT_EXPIRY=7d

# ── Google OAuth ──
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/v1/auth/google/callback

# ── MQTT ──
MQTT_BROKER_URL=mqtt://localhost:1883
MQTT_USERNAME=
MQTT_PASSWORD=

# ── Frontend ──
FRONTEND_URL=http://localhost:5173

# ── CORS ──
CORS_ORIGIN=http://localhost:5173

# ── Hardware Security & Admin Access Control ──
# Comma-separated list of initial bootstrap superadmins who bypass registration approval
ADMIN_EMAILS=admin@sentinel.local
# When true, all new self-registrations and unknown Google logins require administrator approval
REQUIRE_ADMIN_APPROVAL=true

